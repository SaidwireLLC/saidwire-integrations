{
  "name": "n8n-nodes-saidwire",
  "version": "0.1.0",
  "description": "n8n community node for Saidwire speech-to-text: transcribe English audio to text, timestamps or SRT/VTT subtitles.",
  "license": "MIT",
  "homepage": "https://saidwire.com/docs/api",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "saidwire",
    "speech-to-text",
    "transcription",
    "subtitles",
    "audio"
  ],
  "author": {
    "name": "Saidwire",
    "email": "support@saidwire.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SaidwireLLC/saidwire-integrations.git",
    "directory": "packages/n8n-nodes-saidwire"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node --test test/saidwire.test.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SaidwireApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Saidwire/Saidwire.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/SaidwireLLC/saidwire-integrations/issues",
    "email": "support@saidwire.com"
  },
  "publishConfig": {
    "access": "public"
  }
}
